{
  "jobDefinitionName": "ragwarrant-governance-batch",
  "type": "container",
  "platformCapabilities": ["FARGATE"],
  "containerProperties": {
    "image": "RAGWARRANT_IMAGE_REFERENCE_PLACEHOLDER",
    "command": [
      "run-governance-job",
      "--config",
      "/inputs/public_mini_governance_job.yaml",
      "--output-root",
      "/outputs",
      "--decision-out",
      "/outputs/promotion_decision.json"
    ],
    "resourceRequirements": [
      {"type": "VCPU", "value": "1"},
      {"type": "MEMORY", "value": "2048"}
    ],
    "executionRoleArn": "<batch-execution-role-arn>",
    "environment": [
      {"name": "RAGWARRANT_STORAGE_MODE", "value": "local"},
      {"name": "RAGWARRANT_INPUT_DIR", "value": "/inputs"},
      {"name": "RAGWARRANT_OUTPUT_DIR", "value": "/outputs"}
    ],
    "readonlyRootFilesystem": true
  }
}
